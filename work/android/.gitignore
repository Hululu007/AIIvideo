# Gradle / AGP
.gradle/
build/
local.properties
*.iml

# 派生资源：site-default.json 是唯一来源，site-web.js 每次 preBuild 现生成
app/src/main/assets/site-web.js

# 构建脚本的临时产物
.build-last-apk
.build/

# 签名（本地各自配一份；公开仓库不放密钥）
keystore/
keystore.properties
*.keystore
*.jks

# 编辑器和系统
.DS_Store
Thumbs.db
.idea/
*.swp

# 测试 fixture 是成人内容站点的真实页面，不进仓库（避开内容污染，不是怕版权）。
# 缺了它们 Hanime1AdapterTest 的 16 个用例会被 Assume 跳过，不会红。
# 需要跑的话：cd work/shells/java-test/fixtures && python3 refresh.py
app/src/test/resources/*.html
