      "zani.iwara.tv"
    ]
  },
  "web": {
    "spider": "https://149.104.21.177.sslip.io/spiders/iwara.js",
    "firstPageSize": 32,
    "pageSize": 32,
    "shield": {
      "_why": "www/api/filesq/视频 CDN 全在 Cloudflare 盾后：带完整安卓 Chrome 头裸 curl 也是 403 + 5.4KB 的 Just a moment（差的是 TLS 指纹，不是 UA）。这里只写 iwara.tv 一个裸域 —— ShieldProfile.matches 是「精确相等 或 后缀 .iwara.tv」，一条就把 www / api / filesq / 那三十来个随机 CDN 别名全罩住。warmup 选最轻的列表页，cookie 是 clearance 归属的 origin。",
      "warmup": "https://www.iwara.tv/videos",
      "hosts": [
        "iwara.tv"
      ],
      "cookie": "https://www.iwara.tv/"
    },
