# 拷贝成 .env 再填。**不要提交 .env。**
# deploy.sh 发现 .env 不存在时会自动生成这两个随机串并把 .env 写出来，
# 一般不需要手填 —— 手填只在换密钥/换口令时才做。

# track 库的口令（openssl rand -hex 32）
POSTGRES_PASSWORD=换成一个长随机串

# App 侧算 X-Sig 的密钥，**必须和 App 里的那份完全一致**。
# 换了它，旧版 App 的上报全部 401 —— 换之前先发一版带新密钥的客户端。
TRACK_SECRET=换成一个长随机串

# 明细留存天数
RETENTION_DAYS=90
# 按哪个时区切「一天」（聚合和 90 天保留都按它算）
AGG_TZ=Asia/Shanghai
# 单 IP 每分钟次数
RATE_LIMIT_PER_MINUTE=60
# 单次批量条数
MAX_EVENTS=200
