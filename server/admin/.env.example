# 后台登录（首次启动时写入 admin.db；之后改密码请在网页里改）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
# 会话签名密钥，随便一串长随机
SECRET=change-me-too
# 账号库（与 server/account 的 .env 保持一致）
POSTGRES_PASSWORD=change-me-db
# 源文件目录（Caddy 的 root）
CFG_DIR=/srv/cfg
# 公网地址，用于文档与跳转提示
PUBLIC_BASE=https://149.104.21.177.sslip.io

# 埋点服务的只读接口（数据页）。TRACK_STATS_TOKEN 要和 /srv/track/.env 的
# STATS_TOKEN 完全一致；留空的话数据页只会显示「没配」，其它页不受影响。
TRACK_URL=http://127.0.0.1:8092
TRACK_STATS_TOKEN=change-me-same-as-track
